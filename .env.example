# 서버 환경 변수 예시. 복사해서 .env로 쓴다(.env는 git에 올리지 않는다).
PORT=3000
# Postgres 없이 실행하려면 sqljs로 둔다(로컬 파일 dev.sqlite에 저장).
DB_TYPE=sqljs
# Postgres를 쓰려면 DB_TYPE을 지우고 아래를 채운다.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=antifreeze_db
# 로그인 토큰 서명용 비밀키(필수). 개발용 값이며, 운영에서는 긴 난수로 바꾼다.
JWT_SECRET=dev-only-change-me
# 사진 분석(POST /meals/upload)에만 필요하다.
GEMINI_API_KEY=
